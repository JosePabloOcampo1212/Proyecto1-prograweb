@model TablaTicketsViewModel
@if (Model.Tickets.Count == 0)
{
    <div class="alert alert-light border text-center mb-0">No se encontraron tickets.</div>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">N.º</th>
                    <th scope="col">Título</th>
                    <th scope="col">Categoría</th>
                    @if (Model.MostrarSolicitante)
                    {
                        <th scope="col">Solicitante</th>
                    }
                    <th scope="col">Asignado a</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-nowrap">Última actualización</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tickets)
                {
                    <tr>
                        <td class="text-muted">#@t.Id</td>
                        <td><a class="fw-semibold text-decoration-none" href="@Url.Action("Detalle", "Tickets", new { id = t.Id })">@t.Titulo</a></td>
                        <td>@t.Categoria</td>
                        @if (Model.MostrarSolicitante)
                        {
                            <td>@t.NombreSolicitante</td>
                        }
                        <td>
                            @if (t.NombreAsignado != null)
                            {
                                @t.NombreAsignado
                            }
                            else
                            {
                                <span class="text-muted">Sin asignar</span>
                            }
                        </td>
                        <td><span class="badge @EstiloEstado.Clase(t.IdEstado)">@t.NombreEstado</span></td>
                        <td class="text-nowrap">@Formato.Fecha(t.FechaActualizacion)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="form-text mt-2">@Model.Tickets.Count @(Model.Tickets.Count == 1 ? "ticket" : "tickets")</div>
}
