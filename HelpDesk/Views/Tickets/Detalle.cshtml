@model TicketDetalleViewModel
@{
    var t = Model.Ticket;
    ViewBag.Title = "Ticket #" + t.Id;
}
@Html.AntiForgeryToken()

<a class="d-inline-block mb-3 text-decoration-none" href="@Url.Action("Index")">&larr; Volver al listado</a>

<div class="row g-4" id="detalleTicket"
     data-id="@t.Id"
     data-url-listar="@Url.Action("Listar", "Comentarios")"
     data-url-agregar="@Url.Action("Agregar", "Comentarios")">

    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="text-muted small mb-1">Ticket #@t.Id &middot; @t.Categoria</div>
                        <h1 class="h4 mb-0">@t.Titulo</h1>
                    </div>
                    <span id="badgeEstado" class="badge fs-6 @EstiloEstado.Clase(t.IdEstado)">@t.NombreEstado</span>
                </div>
                <p class="mt-3 mb-0 texto-multilinea">@t.Descripcion</p>
            </div>
            @if (Model.PuedeEditar)
            {
                <div class="card-footer bg-white">
                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar", new { id = t.Id })">Editar ticket</a>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header bg-white d-flex align-items-center gap-2">
                <h2 class="h5 mb-0">Comentarios</h2>
                <span id="totalComentarios" class="badge text-bg-light border">0</span>
            </div>
            <div class="card-body">
                <div id="listaComentarios" aria-live="polite">
                    <div class="text-muted">Cargando comentarios...</div>
                </div>

                <form id="formComentario" class="mt-3 @(Model.PuedeComentar ? "" : "d-none")" novalidate>
                    <label for="textoComentario" class="form-label fw-semibold">Agregar comentario</label>
                    <textarea id="textoComentario" class="form-control" rows="3" maxlength="1000"
                              placeholder="Escriba información adicional o una respuesta"></textarea>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <small class="text-muted"><span id="contadorComentario">0</span>/1000</small>
                        <button type="submit" class="btn btn-primary" id="btnComentar">Agregar comentario</button>
                    </div>
                    <div id="mensajeComentario" class="mt-2"></div>
                </form>

                <div id="avisoCerrado" class="alert alert-secondary mt-3 mb-0 @(Model.PuedeComentar ? "d-none" : "")">
                    El ticket está cerrado y ya no admite comentarios.
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Información</h2></div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between gap-3">
                    <span class="text-muted">Solicitante</span><span class="text-end">@t.NombreSolicitante</span>
                </li>
                <li class="list-group-item d-flex justify-content-between gap-3">
                    <span class="text-muted">Asignado a</span><span class="text-end" id="infoAsignado">@(t.NombreAsignado ?? "Sin asignar")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between gap-3">
                    <span class="text-muted">Creado</span><span>@Formato.Fecha(t.FechaCreacion)</span>
                </li>
                <li class="list-group-item d-flex justify-content-between gap-3">
                    <span class="text-muted">Última actualización</span><span id="infoActualizacion">@Formato.Fecha(t.FechaActualizacion)</span>
                </li>
                <li class="list-group-item d-flex justify-content-between gap-3">
                    <span class="text-muted">Resuelto</span><span id="infoResolucion">@(Formato.Fecha(t.FechaResolucion) ?? "—")</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/app/comentarios.js"></script>
}
