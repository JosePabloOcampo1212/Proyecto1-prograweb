@model TicketFormViewModel
@Html.HiddenFor(m => m.Id)

<div class="mb-3">
    <label for="Titulo" class="form-label">Título</label>
    @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", maxlength = "150", placeholder = "Resumen corto del problema" })
    @Html.ValidationMessageFor(m => m.Titulo, null, new { @class = "text-danger small" })
</div>

<div class="mb-3">
    <label for="Categoria" class="form-label">Categoría</label>
    @Html.DropDownListFor(m => m.Categoria, new SelectList(Categorias.Lista, Model.Categoria), "Seleccione una categoría", new { @class = "form-select" })
    @Html.ValidationMessageFor(m => m.Categoria, null, new { @class = "text-danger small" })
</div>

<div class="mb-4">
    <label for="Descripcion" class="form-label">Descripción</label>
    @Html.TextAreaFor(m => m.Descripcion, 6, 40, new { @class = "form-control", maxlength = "4000", placeholder = "Qué sucede, desde cuándo y qué se ha intentado" })
    @Html.ValidationMessageFor(m => m.Descripcion, null, new { @class = "text-danger small" })
</div>
