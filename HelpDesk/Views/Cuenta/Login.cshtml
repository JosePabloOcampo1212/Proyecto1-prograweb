@model LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}
<div class="row justify-content-center pt-md-5">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="text-center mb-4">
            <svg class="marca-logo-login" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <linearGradient id="geoGradLogin" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" style="stop-color:#6366f1;stop-opacity:1" />
                        <stop offset="100%" style="stop-color:#4f46e5;stop-opacity:1" />
                    </linearGradient>
                </defs>
                <path d="M 24 8 L 32 18 L 16 18 Z" fill="url(#geoGradLogin)"/>
                <rect x="12" y="22" width="8" height="16" fill="url(#geoGradLogin)" opacity="0.8"/>
                <rect x="28" y="22" width="8" height="16" fill="url(#geoGradLogin)" opacity="0.6"/>
                <circle cx="24" cy="30" r="4" fill="#fff" opacity="0.3"/>
            </svg>
            <h1 class="h3 mt-3 mb-1">Help Desk</h1>
            <p class="text-muted mb-0">Sistema de gestión de solicitudes de soporte técnico</p>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post, new { autocomplete = "on" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)
                    @Html.Partial("_ErroresGenerales")

                    <div class="mb-3">
                        <label for="Email" class="form-label">Correo electrónico</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "username", autofocus = "autofocus", maxlength = "150" })
                        @Html.ValidationMessageFor(m => m.Email, null, new { @class = "text-danger small" })
                    </div>
                    <div class="mb-4">
                        <label for="Contrasena" class="form-label">Contraseña</label>
                        @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", autocomplete = "current-password", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.Contrasena, null, new { @class = "text-danger small" })
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                }
            </div>
        </div>
    </div>
</div>
