@model ReporteViewModel
@{
    ViewBag.Title = "Reportes";
}
<h1 class="h3 mb-1">Reportes de soporte</h1>
<p class="text-muted">Carga de trabajo actual y tiempos de resolución del área de soporte técnico.</p>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Tickets por estado</h2>
                <small class="text-muted">Situación actual de todos los tickets</small>
            </div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Cantidad</th>
                            <th scope="col" class="text-end">Porcentaje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in Model.PorEstado)
                        {
                            <tr>
                                <td><span class="badge @EstiloEstado.Clase(fila.IdEstado)">@fila.Estado</span></td>
                                <td class="text-end">@fila.Cantidad</td>
                                <td class="text-end">@(Model.TotalTickets == 0 ? "0" : (fila.Cantidad * 100.0 / Model.TotalTickets).ToString("0.#"))%</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-semibold">
                            <td>Total</td>
                            <td class="text-end">@Model.TotalTickets</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Resumen por periodo</h2>
                <small class="text-muted">Tickets creados y resueltos entre las fechas seleccionadas</small>
            </div>
            <div class="card-body">
                <form method="get" action="@Url.Action("Index")" class="row g-2 align-items-end mb-3">
                    <div class="col-sm-5">
                        <label class="form-label" for="desde">Desde</label>
                        <input type="date" id="desde" name="desde" class="form-control" value="@Model.Desde.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label" for="hasta">Hasta</label>
                        <input type="date" id="hasta" name="hasta" class="form-control" value="@Model.Hasta.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-sm-2">
                        <button type="submit" class="btn btn-primary w-100">Generar</button>
                    </div>
                </form>

                @if (Model.Error != null)
                {
                    <div class="alert alert-warning mb-0">@Model.Error</div>
                }
                else
                {
                    <div class="row g-2 text-center mb-3">
                        <div class="col-4">
                            <div class="indicador">
                                <div class="indicador-valor">@Model.Resumen.Creados</div>
                                <div class="indicador-etiqueta">Creados</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="indicador">
                                <div class="indicador-valor">@Model.Resumen.Resueltos</div>
                                <div class="indicador-etiqueta">Resueltos</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="indicador">
                                <div class="indicador-valor">@(Model.Resumen.PromedioHoras.HasValue ? Formato.Horas(Model.Resumen.PromedioHoras.Value) : "—")</div>
                                <div class="indicador-etiqueta">Tiempo promedio de resolución</div>
                            </div>
                        </div>
                    </div>

                    <h3 class="h6">Tickets resueltos en el periodo</h3>
                    if (Model.TicketsResueltos.Count == 0)
                    {
                        <p class="text-muted mb-0">No hay tickets resueltos en este periodo.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">N.º</th>
                                        <th scope="col">Título</th>
                                        <th scope="col">Atendido por</th>
                                        <th scope="col">Resuelto</th>
                                        <th scope="col" class="text-end">Tiempo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.TicketsResueltos)
                                    {
                                        <tr>
                                            <td class="text-muted">#@r.Id</td>
                                            <td><a class="text-decoration-none" href="@Url.Action("Detalle", "Tickets", new { id = r.Id })">@r.Titulo</a></td>
                                            <td>@(r.Asignado ?? "Sin asignar")</td>
                                            <td class="text-nowrap">@Formato.Fecha(r.FechaResolucion)</td>
                                            <td class="text-end text-nowrap">@Formato.Horas(r.HorasResolucion)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
