@{
    ModelState estadoGeneral;
    ViewData.ModelState.TryGetValue(string.Empty, out estadoGeneral);
}
@if (estadoGeneral != null && estadoGeneral.Errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in estadoGeneral.Errors)
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}
